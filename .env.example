# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# Only required for src/utils/s3_utils.py (production decision-summary upload,
# Streamlit dashboard's S3 data source). Not required to run the training pipeline,
# the API in local-score mode, or the test suite.

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
